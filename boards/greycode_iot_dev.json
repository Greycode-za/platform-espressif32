{
  "build": {
    "core": "esp32",
    "extra_flags": "-DARDUINO_GREYCODE_IOT_DEV",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "mcu": "esp32",
    "variant": "esp32",
    "partitions": "default.csv"
  },
  "connectivity": [
    "wifi",
    "bluetooth",
    "gps"
  ],
  "debug": {
    "openocd_board": "esp32-wrover-kit.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "Greycode IoT Dev Board",
  "upload": {
    "maximum_ram_size": 327680,
    "maximum_size": 8388608,
    "require_upload_port": true,
    "speed": 921600,
    "flash_size": "8MB",
    "protocol": "esptool"
  },
  "url": "https://github.com/greycode-za",
  "vendor": "Greycode",
  "version": "1.0.0"
}
